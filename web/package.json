{
  "name": "shepherd-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint --write .",
    "fmt": "biome format --write .",
