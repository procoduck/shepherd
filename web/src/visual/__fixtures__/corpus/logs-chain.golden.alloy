// generated by shepherd visual builder — do not edit by hand (edits will be overwritten); graph revision 4, schema v1.18.1

local.file_match "logfiles" {
  path_targets = [{__path__ = "/var/log/pods/*/*.log", job = "pods"}]
  sync_period = "10s"
}

loki.source.file "pods" {
  targets = [local.file_match.logfiles.targets]
  forward_to = [loki.process.parse.receiver]
  tail_from_end = true
}

loki.process "parse" {
  forward_to = [loki.write.cloud.receiver]
  stage.json {
    expressions = {level = "level", msg = "message"}
  }
  stage.labels {
    values = {level = ""}
  }
}

loki.write "cloud" {
  external_labels = {cluster = "eu-1"}
  endpoint {
    url = "https://loki.example.com/loki/api/v1/push"
    tenant_id = "team-a"
  }
}
