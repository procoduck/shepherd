// generated by shepherd visual builder — do not edit by hand (edits will be overwritten); graph revision 5, schema v1.18.1

discovery.kubernetes "k8s" {
  role = "pod"
}

discovery.relabel "first" {
  targets = [discovery.kubernetes.k8s.targets]
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex = "Running"
    action = "keep"
  }
}

discovery.relabel "second" {
  targets = [discovery.kubernetes.k8s.targets]
  rule {
    source_labels = ["__meta_kubernetes_pod_label_team"]
    target_label = "team"
    action = "replace"
  }
}

prometheus.scrape "app" {
  targets = [discovery.relabel.first.output, discovery.relabel.second.output]
  forward_to = [prometheus.remote_write.sink.receiver]
  job_name = "app"
}

prometheus.remote_write "sink" {
  endpoint {
    url = "https://prometheus.example.com/api/v1/write"
  }
}
