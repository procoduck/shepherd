// node "infra" disabled

discovery.kubernetes "k8s" {
  role = "pod"
}

loki.source.file "pods" {
}

discovery.relabel "filter" {
  targets = [discovery.kubernetes.k8s.targets]
}

prometheus.scrape "app" {
  job_name = "myapp"
  scrape_interval = "60s"
  targets = [discovery.relabel.filter.output]
}

prometheus.relabel "drop_internal" {
  forward_to = [prometheus.scrape.app.metrics]
}

loki.write "loki_cloud" {
  receiver = [loki.source.file.pods.logs]
}

prometheus.remote_write "primary" {
  receiver = [prometheus.scrape.app.metrics]
}
