{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // TypeScript 7 no longer auto-includes every @types/* package: `node` is what the
    // filesystem-reading unit tests (and tests/fixtures/schema-fixture.ts) need, and
    // `vite/client` declares the side-effect `*.css` imports that TS 7 now checks
    // (noUncheckedSideEffectImports defaults to true).
    "types": ["node", "vite/client"],
    // Relative to this file (baseUrl was removed in TypeScript 7); Vite resolves the
    // same alias on its own in vite.config.ts.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
