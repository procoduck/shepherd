# Go build output
/bin/
*.test
*.out
coverage.txt

# Node / frontend (see also web/.gitignore)
node_modules/
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Local environment overrides — never commit real credentials
.env
.env.*
!deploy/versions.env

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# Local code-intelligence index
.codegraph/

# GoReleaser output
/dist/

# Playwright walkthrough screenshots
web/walkthrough/

# Agent-local .claude scratch stays out of the index — worktrees (each a full
# checkout with its own build outputs; see the check-single-dist guard) and
# RESUME.md notes. Two governance files are exceptions: the contributor-PR
# review policy and the slash commands must travel with the repo so the
# AGENTS.md pointer resolves on a fresh clone and in CI.
/.claude/*
!/.claude/pr-review-security.md
!/.claude/commands/

# Playwright MCP session artifacts (screenshots, snapshots, console logs)
/.playwright-mcp/
/walkthrough/
