# Go build output
/bin/
*.test
*.out
coverage.txt

# Node / frontend (see also web/.gitignore)
node_modules/
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Local environment overrides — never commit real credentials
.env
.env.*
!deploy/versions.env

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local code-intelligence index
.codegraph/

# GoReleaser output
/dist/

# Playwright walkthrough screenshots
web/walkthrough/

# Agent git worktrees (see the check-single-dist guard). Each is a full
# checkout with its own build outputs; none of it belongs in this repo's index.
/.claude/
