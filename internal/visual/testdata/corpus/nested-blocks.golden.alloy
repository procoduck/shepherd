discovery.kubernetes "k8s" {
  role = "pod"
  tls_config {
    ca_file = "/etc/ssl/certs/ca.pem"
    insecure_skip_verify = false
  }
  namespaces {
    names = ["monitoring", "default"]
  }
}

prometheus.scrape "app" {
  targets = discovery.kubernetes.k8s.targets
  forward_to = [prometheus.remote_write.primary.receiver]
  job_name = "app"
  scrape_interval = "30s"
  tls_config {
    server_name = "app.svc"
    insecure_skip_verify = false
  }
  clustering {
    enabled = true
  }
}

prometheus.remote_write "primary" {
  external_labels = {cluster = "eu-1"}
  endpoint {
    name = "primary"
    url = "https://prometheus-a.example.com/api/v1/write"
    remote_timeout = "30s"
    queue_config {
      capacity = 10000
      max_shards = 50
    }
  }
  endpoint {
    name = "secondary"
    url = "https://prometheus-b.example.com/api/v1/write"
  }
}
