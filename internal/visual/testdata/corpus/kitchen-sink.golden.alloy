// generated by shepherd visual builder — do not edit by hand (edits will be overwritten); graph revision 9, schema v1.18.1
// node "infra" disabled

discovery.kubernetes "k8s" {
  role = "pod"
}

local.file_match "logfiles" {
  path_targets = [{__path__ = "/var/log/app/*.log", job = "app"}]
}

loki.source.file "applogs" {
  targets = local.file_match.logfiles.targets
  forward_to = [loki.write.loki_cloud.receiver]
}

discovery.relabel "filter" {
  targets = discovery.kubernetes.k8s.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex = "kube-system"
    action = "drop"
  }
}

prometheus.scrape "app" {
  targets = discovery.relabel.filter.output
  forward_to = [prometheus.relabel.drop_internal.receiver]
  job_name = "myapp"
  honor_labels = true
  scrape_interval = "60s"
}

prometheus.relabel "drop_internal" {
  forward_to = [prometheus.remote_write.primary.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "go_.*"
    action = "drop"
  }
}

loki.write "loki_cloud" {
  endpoint {
    url = "https://loki.example.com/loki/api/v1/push"
  }
}

prometheus.remote_write "primary" {
  external_labels = {cluster = "eu-1"}
  endpoint {
    url = "https://prometheus.example.com/api/v1/write"
    remote_timeout = "30s"
  }
}
