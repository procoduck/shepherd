// generated by shepherd visual builder — do not edit by hand (edits will be overwritten); 9 nodes, schema v1.21.2

local.file "otel_ca" {
  filename = "/etc/otel/ca.pem"
}

remote.kubernetes.secret "creds" {
  namespace = "monitoring"
  name = "shepherd-creds"
}

discovery.kubernetes "k8s" {
  role = "pod"
}

otelcol.receiver.otlp "ingest" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.exporter.otlp.gateway.input]
  }
}

loki.process "tenant" {
  forward_to = [loki.write.logs.receiver]
  stage.tenant {
    value = convert.nonsensitive(remote.kubernetes.secret.creds.data["tenant"])
  }
}

prometheus.scrape "app" {
  targets = discovery.kubernetes.k8s.targets
  forward_to = [prometheus.remote_write.sink.receiver]
  job_name = "app"
}

loki.write "logs" {
  endpoint {
    url = "https://loki.example.com/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "gateway" {
  client {
    endpoint = convert.nonsensitive(remote.kubernetes.secret.creds.data["otlp_endpoint"])
    compression = "gzip"
    tls {
      ca_pem = local.file.otel_ca.content
    }
  }
}

prometheus.remote_write "sink" {
  endpoint {
    url = "https://primary.example.com/api/v1/write"
    basic_auth {
      username = "shepherd"
      password = remote.kubernetes.secret.creds.data["password"]
    }
  }
  endpoint {
    url = "https://secondary.example.com/api/v1/write"
    bearer_token = remote.kubernetes.secret.creds.data["token"]
  }
}
