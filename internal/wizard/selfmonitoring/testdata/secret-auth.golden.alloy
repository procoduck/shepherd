prometheus.exporter.self "alloy" {}

prometheus.scrape "self" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "60s"
  job_name        = "alloy-self"
}

remote.kubernetes.secret "metrics_auth" {
  namespace = "monitoring"
  name      = "mimir-credentials"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-basic"
    url  = "https://mimir.example.com/api/v1/push"

    basic_auth {
      username = convert.nonsensitive(remote.kubernetes.secret.metrics_auth.data["username"])
      password = remote.kubernetes.secret.metrics_auth.data["password"]
    }
  }
}

loki.source.file "self" {
  targets = [
    {__path__ = "/var/log/alloy/*.log", job = "alloy-self"},
  ]
  forward_to = [loki.write.logs.receiver]
}

remote.kubernetes.secret "logs_auth" {
  namespace = "monitoring"
  name      = "loki-oauth"
}

loki.write "logs" {
  endpoint {
    name = "loki-oauth"
    url  = "https://loki.example.com/loki/api/v1/push"

    oauth2 {
      client_id     = convert.nonsensitive(remote.kubernetes.secret.logs_auth.data["client_id"])
      client_secret = remote.kubernetes.secret.logs_auth.data["client_secret"]
      token_url     = convert.nonsensitive(remote.kubernetes.secret.logs_auth.data["token_url"])
      scopes        = ["api://loki/.default"]
    }
  }
}
