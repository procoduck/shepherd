prometheus.exporter.self "alloy" {}

prometheus.scrape "self" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "60s"
  job_name        = "alloy-self"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-prod"
    url  = "https://mimir.prod.example.com/api/v1/push"
  }
}

local.file_match "self" {
  path_targets = [
    {__path__ = "/var/log/alloy/*.log", job = "alloy-self"},
  ]
}

loki.source.file "self" {
  targets    = local.file_match.self.targets
  forward_to = [loki.write.logs.receiver]
}

loki.write "logs" {
  endpoint {
    name = "loki-prod"
    url  = "https://loki.prod.example.com/loki/api/v1/push"
  }
}
