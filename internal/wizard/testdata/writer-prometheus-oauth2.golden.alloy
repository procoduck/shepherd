remote.kubernetes.secret "metrics_auth" {
  namespace = "monitoring"
  name      = "mimir-oauth"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-prod"
    url  = "https://mimir.example.com/api/v1/push"

    oauth2 {
      client_id     = convert.nonsensitive(remote.kubernetes.secret.metrics_auth.data["client_id"])
      client_secret = remote.kubernetes.secret.metrics_auth.data["client_secret"]
      token_url     = convert.nonsensitive(remote.kubernetes.secret.metrics_auth.data["token_url"])
    }
  }
}
