discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "prod-.*"
    action        = "keep"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.logs.receiver]
}

remote.kubernetes.secret "logs_auth" {
  namespace = "monitoring"
  name      = "loki-oauth"
}

loki.write "logs" {
  endpoint {
    name = "loki-oauth"
    url  = "https://loki.example.com/loki/api/v1/push"

    oauth2 {
      client_id     = convert.nonsensitive(remote.kubernetes.secret.logs_auth.data["client_id"])
      client_secret = remote.kubernetes.secret.logs_auth.data["client_secret"]
      token_url     = convert.nonsensitive(remote.kubernetes.secret.logs_auth.data["token_url"])
      scopes        = ["api://loki/.default"]
    }
  }
}
