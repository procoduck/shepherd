prometheus.exporter.cadvisor "cluster" {
  docker_only = false
}

prometheus.scrape "cluster_metrics" {
  targets          = prometheus.exporter.cadvisor.cluster.targets
  forward_to       = [prometheus.remote_write.metrics.receiver]
  scrape_interval  = "60s"
  job_name         = "cluster-metrics"
}

remote.kubernetes.secret "metrics_auth" {
  namespace = "monitoring"
  name      = "mimir-credentials"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-basic"
    url  = "https://mimir.example.com/api/v1/push"

    basic_auth {
      username = convert.nonsensitive(remote.kubernetes.secret.metrics_auth.data["username"])
      password = remote.kubernetes.secret.metrics_auth.data["password"]
    }
  }
}
