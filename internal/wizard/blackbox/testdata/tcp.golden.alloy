prometheus.exporter.blackbox "probes" {
  target {
    name    = "db-internal-5432"
    address = "db.internal:5432"
    module  = "tcp_connect"
  }
}

prometheus.scrape "probes" {
  targets         = prometheus.exporter.blackbox.probes.targets
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
  job_name        = "blackbox-tcp"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-staging"
    url  = sys.env("SHEPHERD_DEST_PROM_STAGING_URL")
    // auth injected by Shepherd at serve time
  }
}
