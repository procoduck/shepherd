remote.kubernetes.secret "db_credentials" {
  namespace = "databases"
  name      = "app-pg"
}

prometheus.exporter.postgres "db" {
  data_source_names = [remote.kubernetes.secret.db_credentials.data["dsn"]]
}

prometheus.scrape "database" {
  targets         = prometheus.exporter.postgres.db.targets
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "60s"
  job_name        = "app-db"
}

remote.kubernetes.secret "metrics_auth" {
  namespace = "monitoring"
  name      = "mimir-credentials"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-basic"
    url  = "https://mimir.example.com/api/v1/push"

    basic_auth {
      username = convert.nonsensitive(remote.kubernetes.secret.metrics_auth.data["username"])
      password = remote.kubernetes.secret.metrics_auth.data["password"]
    }
  }
}
