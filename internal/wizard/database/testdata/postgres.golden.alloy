prometheus.exporter.postgres "db" {
  data_source_names = [sys.env("APP_PG_DSN")]
}

prometheus.scrape "database" {
  targets         = prometheus.exporter.postgres.db.targets
  forward_to      = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "60s"
  job_name        = "app-db"
}

prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-prod"
    url  = sys.env("SHEPHERD_DEST_PROM_PROD_URL")
    // auth injected by Shepherd at serve time
  }
}
