prometheus.scrape "app" {
  targets = [{
    "__address__"      = "app:9090",
    "__scheme__"       = "http",
    "__metrics_path__" = "/metrics",
  }]
  forward_to = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
  job_name = "app"
}
prometheus.remote_write "metrics" {
  endpoint {
    name = "prom-prod"
    url  = "https://mimir.prod.example.com/api/v1/push"
  }
}
local.file_match "app_logs" {
  path_targets = [
    {__path__ = "/var/log/app/*.log", job = "app"},
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app_process.receiver]
}

loki.process "app_process" {
  forward_to = [loki.write.logs.receiver]

  stage.logfmt {
    mapping = { level = "" }
  }

  stage.labels {
    values = { level = "" }
  }
}

loki.write "logs" {
  endpoint {
    name = "loki-prod"
    url  = "https://loki.prod.example.com/loki/api/v1/push"
  }
}
