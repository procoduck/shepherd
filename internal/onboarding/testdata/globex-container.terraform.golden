# Layer this into the aws_lambda_function resource for "billing-worker".
# Route: kind=otlp segment=k7f3n9qp3mx8vh2q

resource "aws_lambda_function" "this" {
  # ... function_name, role, handler, runtime, etc. unchanged ...

  environment {
    variables = {
      OTEL_EXPORTER_OTLP_ENDPOINT = "https://telemetry.example.com/otlp/k7f3n9qp3mx8vh2q"
      OTEL_EXPORTER_OTLP_PROTOCOL = "http/json"
      OTEL_SERVICE_NAME = "billing-worker"
    }
  }
}
