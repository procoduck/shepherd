# Shepherd OTLP ingest for "billing-worker", route segment "k7f3n9qp3mx8vh2q".
#
# OTEL_EXPORTER_OTLP_ENDPOINT is a BASE endpoint: the OTLP/HTTP exporter
# appends v1/traces, v1/metrics, v1/logs itself. Do not append a signal path
# to it, and do not set an OTEL_EXPORTER_OTLP_<SIGNAL>_ENDPOINT override
# without also appending that signal's path — the per-signal variables are
# used exactly as given, with nothing appended.
#
# The route segment in this endpoint identifies your tenant to the gateway;
# it is not a secret credential (docs/gateway-tier-plan.md §3) — treat it
# like any other endpoint URL in your config, not like an API key.
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com/otlp/k7f3n9qp3mx8vh2q
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_SERVICE_NAME=billing-worker
