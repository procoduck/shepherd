otelcol.receiver.otlp "acme" {
  grpc {
    endpoint               = "0.0.0.0:4317"
    max_recv_msg_size      = "4MiB"
    max_concurrent_streams = 100
  }
  http {
    endpoint               = "0.0.0.0:4318"
    max_request_body_size  = "8MiB"
  }
  // no requests/sec limit is expressible here — see package doc.
  output {
    metrics = [otelcol.processor.batch.acme.input]
    logs    = [otelcol.processor.batch.acme.input]
    traces  = [otelcol.processor.batch.acme.input]
  }
}

otelcol.processor.batch "acme" {
  timeout = "5s"
  send_batch_size = 1000
  send_batch_max_size = 1500
  output {
    metrics = [otelcol.exporter.otlp.acme_mimir.input]
    logs    = [otelcol.exporter.otlphttp.acme_loki_otlp.input]
    traces  = [otelcol.exporter.otlp.acme_tempo.input]
  }
}

otelcol.exporter.otlp "acme_mimir" {
  client {
    endpoint = sys.env("SHEPHERD_DEST_ACME_MIMIR_URL")
    headers = {
      "X-Scope-OrgID" = "acme",
    }
  }
}

otelcol.exporter.otlphttp "acme_loki_otlp" {
  client {
    endpoint = sys.env("SHEPHERD_DEST_ACME_LOKI_URL")
    headers = {
      "Authorization" = sys.env("SHEPHERD_DEST_ACME_LOKI_TOKEN"),
      "X-Scope-OrgID" = "acme",
    }
  }
}

otelcol.exporter.otlp "acme_tempo" {
  client {
    endpoint = sys.env("SHEPHERD_DEST_ACME_TEMPO_URL")
    headers = {
      "Authorization" = sys.env("SHEPHERD_DEST_ACME_TEMPO_TOKEN"),
    }
  }
}

faro.receiver "acme" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    max_allowed_payload_size = "5MiB"
    // CORS answers docs/gateway-tier-plan.md D2: the Gateway API Standard
    // channel carries no CORS filter at the pinned floor, so this receiver is
    // the only place origin is enforced for browser traffic.
    cors_allowed_origins = ["https://app.acme.example.com"]
    rate_limiting {
      enabled = true
      strategy   = "global"
      rate       = 50
      burst_size = 100
    }
  }
  output {
    logs   = [loki.write.acme_faro_logs2.receiver]
    traces = [otelcol.processor.batch.faro_acme_traces.input]
  }
}

loki.write "acme_faro_logs2" {
  endpoint {
    url       = sys.env("SHEPHERD_DEST_ACME_LOKI_URL")
    tenant_id = "acme"
    bearer_token = sys.env("SHEPHERD_DEST_ACME_LOKI_TOKEN")
  }
}

otelcol.processor.batch "faro_acme_traces" {
  output {
    traces  = [otelcol.exporter.otlp.acme_faro_tempo2.input]
  }
}

otelcol.exporter.otlp "acme_faro_tempo2" {
  client {
    endpoint = sys.env("SHEPHERD_DEST_ACME_TEMPO_URL")
    headers = {
      "Authorization" = sys.env("SHEPHERD_DEST_ACME_TEMPO_TOKEN"),
    }
  }
}
