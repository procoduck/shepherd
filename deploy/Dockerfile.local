ARG GO_IMAGE=golang:1.27-alpine@sha256:738d1cf061836894ff6bb8c33881080ac66de8cf0586615012a0c8f592649cfa
ARG NODE_IMAGE=node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1
ARG ALLOY_IMAGE=grafana/alloy:v1.20.1@sha256:2aa2099af76c0098d4af7a4d6e48f86cb66dc1a000222ad927a1c67c6542d13f
ARG DISTROLESS_BASE_IMAGE=gcr.io/distroless/base-nossl-debian12:nonroot@sha256:be40c00dfabd86576d92666e87e406714d5618342de1a0c213ad232de255172e
ARG PNPM_VERSION=12.8.1

# Stage 1: Build the web SPA via the canonical build script
FROM ${NODE_IMAGE} AS web
ARG PNPM_VERSION
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/.npmrc web/pnpm-workspace.yaml web/
# Node 25+ no longer bundles corepack, so pnpm comes from npm at the exact
# PNPM_VERSION pin (npm verifies the tarball against the registry integrity).
# --ignore-scripts: pnpm's preinstall only relinks its bin onto the native binary;
# without it the placeholder bin starts that same binary through Node.
# Point npm at your organisation's registry mirror here if applicable.
RUN npm install --global --no-fund --no-audit --ignore-scripts pnpm@${PNPM_VERSION}
COPY web/ web/
COPY scripts/ scripts/
RUN chmod +x scripts/build-web.sh && ./scripts/build-web.sh

# Stage 2: Build the Go binary
FROM ${GO_IMAGE} AS builder
# If your organisation requires a private root CA for outbound TLS, copy it here:
# COPY your-root-ca.crt /usr/local/share/ca-certificates/cert.crt && RUN update-ca-certificates
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /app/internal/spa/dist internal/spa/dist
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /shepherd ./cmd/shepherd

# Stage 3: Get alloy binary
FROM ${ALLOY_IMAGE} AS alloy

# Stage 4: Final image
#
# base-debian12, NOT static-debian12. The alloy binary copied in below is
# dynamically linked (interpreter /lib/ld-linux-*.so), and the static variant
# ships no dynamic loader — the binary lands in the image and then cannot
# execute, failing with a "no such file or directory" that names the loader,
# not the file. That takes Stage 2 (`alloy validate`) out of the validation
# gate in every container deployment. The simulator images already use this
# base for the same reason.
FROM ${DISTROLESS_BASE_IMAGE}
COPY --from=alloy /bin/alloy /usr/local/bin/alloy
COPY --from=builder /shepherd /usr/local/bin/shepherd
USER nonroot
ENTRYPOINT ["/usr/local/bin/shepherd"]
