ARG GO_IMAGE=golang:1.27-alpine@sha256:738d1cf061836894ff6bb8c33881080ac66de8cf0586615012a0c8f592649cfa
ARG NODE_IMAGE=node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1
ARG PNPM_VERSION=12.8.1

# Stage 1: Build the web SPA (required for go:embed to compile)
FROM ${NODE_IMAGE} AS web
ARG PNPM_VERSION
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/.npmrc web/pnpm-workspace.yaml web/
# Node 25+ no longer bundles corepack, so pnpm comes from deploy/pnpm-tool: a
# manifest + lockfile pinned to PNPM_VERSION. `npm ci` checks every tarball
# against the lockfile's committed sha512, never what the registry serves for
# a name; `make check-docker` fails when the lockfile and versions.env disagree,
# and the version test below fails the image if a --build-arg disagrees with it.
# --ignore-scripts: pnpm's preinstall only relinks its bin onto the native binary;
# without it the placeholder bin starts that same binary through Node.
# An npm registry mirror configured here replaces the lockfile's registry host.
COPY deploy/pnpm-tool/package.json deploy/pnpm-tool/package-lock.json /opt/pnpm-tool/
RUN npm ci --prefix /opt/pnpm-tool --ignore-scripts --no-fund --no-audit \
 && test "$(/opt/pnpm-tool/node_modules/.bin/pnpm --version)" = "${PNPM_VERSION}"
ENV PATH=/opt/pnpm-tool/node_modules/.bin:${PATH}
COPY web/ web/
COPY scripts/ scripts/
RUN chmod +x scripts/build-web.sh && ./scripts/build-web.sh

# Stage 2: Build the Go binary
FROM ${GO_IMAGE} AS builder
# If your organisation requires a private root CA for outbound TLS, copy it here:
# COPY your-root-ca.crt /usr/local/share/ca-certificates/cert.crt && RUN update-ca-certificates
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /app/internal/spa/dist internal/spa/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /shepherd ./cmd/shepherd

FROM ${GO_IMAGE}
COPY --from=builder /shepherd /usr/local/bin/shepherd
# The embedded web UI ships elkjs (EPL-2.0): its notice and source pointer.
COPY THIRD_PARTY_NOTICES.md /licenses/THIRD_PARTY_NOTICES.md
# Not root: the init image only runs `migrate` and `dev seed` against Postgres over
# the network; nothing it does needs to write to its own filesystem (Trivy DS-0002).
USER nobody:nobody
ENTRYPOINT ["/usr/local/bin/shepherd"]
