ARG GO_IMAGE=golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628
ARG NODE_IMAGE=node:24-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553
ARG PNPM_VERSION=11.22.0

# Stage 1: Build the web SPA (required for go:embed to compile)
FROM ${NODE_IMAGE} AS web
ARG PNPM_VERSION
ENV COREPACK_NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/.npmrc web/pnpm-workspace.yaml web/
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY web/ web/
COPY scripts/ scripts/
RUN chmod +x scripts/build-web.sh && ./scripts/build-web.sh

# Stage 2: Build the Go binary
FROM ${GO_IMAGE} AS builder
# If your organisation requires a private root CA for outbound TLS, copy it here:
# COPY your-root-ca.crt /usr/local/share/ca-certificates/cert.crt && RUN update-ca-certificates
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /app/internal/spa/dist internal/spa/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /shepherd ./cmd/shepherd

FROM ${GO_IMAGE}
COPY --from=builder /shepherd /usr/local/bin/shepherd
# Not root: the init image only runs `migrate` and `dev seed` against Postgres over
# the network; nothing it does needs to write to its own filesystem (Trivy DS-0002).
USER nobody:nobody
ENTRYPOINT ["/usr/local/bin/shepherd"]
