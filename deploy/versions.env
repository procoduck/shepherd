# Canonical image and tool version pins.
# All Dockerfiles and build scripts consume these via ARG / --build-arg.
# Update here only; the CI check-docker guard enforces consistency.
# Replace with your organisation's registry mirror prefix if applicable.
GO_IMAGE=golang:1.26-alpine
NODE_IMAGE=node:24-slim
ALLOY_IMAGE=grafana/alloy:v1.18.1
ALLOY_VERSION=v1.18.1
DISTROLESS_IMAGE=gcr.io/distroless/static-debian12:nonroot
PNPM_VERSION=11.22.0
