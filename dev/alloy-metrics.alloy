// Alloy instance: cluster=prod-eu-1, role=metrics
remotecfg {
  url = "http://shepherd:8080"
  // The dev seed's agent token (shepherd dev seed), from the environment —
  // the same two vars the beacon baseline Shepherd appends reads, so both
  // authenticate with one token: compose sets them per service, kind from
  // the alloy-agent-token Secret (dev/kind/alloy.yaml).
  basic_auth {
    username = sys.env("SHEPHERD_AGENT_TOKEN_ID")
    password = sys.env("SHEPHERD_AGENT_TOKEN_SECRET")
  }
  attributes = {
    cluster = "prod-eu-1",
    role    = "metrics",
  }
  poll_frequency = "10s"
}
