# Dev-stack environment for dev/docker-compose.dev.yaml.
# ALL values here are dev-only fixtures — never reuse them anywhere real.
# Referenced by docs/dev-guide.md; see docs/spec.md section on the dev stack.

# 32-byte base64 key (dev fixture only).
SHEPHERD_SECURITY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# OIDC is intentionally NOT configured: the `oidc` service in the dev compose sits
# behind the "oidc" profile, so the default `make dev` stack is local-admin only.
# To exercise the OIDC flow: docker compose --profile oidc up -d, then set
# SHEPHERD_OIDC_ISSUER=http://oidc:8090/default, CLIENT_ID/SECRET and
# REDIRECT_URL=http://localhost:8080/auth/callback here.

# App-admin group id matching the seeded personas.
SHEPHERD_AUTH_APP_ADMIN_GROUP_IDS=11111111-1111-1111-1111-111111111111

# Local admin login: admin / admin (matches the make dev banner and tests/fullstack/fixtures.ts).

# Required for the session cookie to be set over plain http://localhost.
SHEPHERD_AUTH_INSECURE_COOKIES=true

SHEPHERD_GITSYNC_TICK=5s
SHEPHERD_LOG_LEVEL=debug

# The first administrator is created on first boot when the users table is empty.
# Set explicitly here so the dev stack does NOT demand a password change on
# first sign-in — that gate exists for the defaulted admin/admin, and a chosen
# password is the operator's to keep. Sign in as admin / admin.
SHEPHERD_BOOTSTRAP_ADMIN_LOGIN=admin
SHEPHERD_BOOTSTRAP_ADMIN_PASSWORD=admin
